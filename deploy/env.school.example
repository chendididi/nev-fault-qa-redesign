POSTGRES_DB=nev_fault_qa
POSTGRES_USER=nev
POSTGRES_PASSWORD=change-me-db-password
DATABASE_URL=postgresql+psycopg://nev:change-me-db-password@postgres:5432/nev_fault_qa
REDIS_URL=redis://redis:6379/0
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001,http://SERVER_IP:3001

JWT_SECRET=change-me-long-random-jwt-secret
JWT_EXPIRE_MINUTES=1440
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin123!
TECH_EMAIL=tech@example.com
TECH_PASSWORD=Tech123!

S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://SERVER_IP:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change-me-minio-password
S3_BUCKET=nev-fault-qa
S3_REGION=us-east-1

OPENAI_BASE_URL=http://vllm:8000/v1
OPENAI_API_KEY=change-me-vllm-key
OPENAI_CHAT_MODEL=qwen-vl-demo
OPENAI_VISION_MODEL=qwen-vl-demo

LOCAL_MODEL_SOURCE=modelscope
LOCAL_MODEL_CACHE_DIR=/app/models
LOCAL_EMBEDDING_MODEL=BAAI/bge-m3
LOCAL_RERANK_MODEL=BAAI/bge-reranker-v2-m3
LOCAL_DEVICE=cuda
EMBEDDING_DIM=1024

TORCH_INDEX_URL=https://download.pytorch.org/whl/cu124
TORCH_PACKAGE=torch==2.11.0+cu124

NEXT_PUBLIC_API_BASE_URL=http://SERVER_IP:8000
WEB_PORT=3001

VLLM_IMAGE=vllm/vllm-openai:latest
VLLM_PORT=8008
VLLM_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
VLLM_SERVED_MODEL_NAME=qwen-vl-demo
VLLM_API_KEY=change-me-vllm-key
VLLM_MAX_MODEL_LEN=16384
VLLM_GPU_MEMORY_UTILIZATION=0.88
HF_TOKEN=
HF_CACHE_DIR=./models/huggingface
